{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "repo-atlas": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/servers/repo-atlas.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "REPO_ATLAS_GLOSSARY": "${PLUGIN_ROOT}/servers/data/glossary.json"
      }
    }
  }
}
